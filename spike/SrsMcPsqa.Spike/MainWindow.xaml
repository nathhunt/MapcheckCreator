<ui:FluentWindow x:Class="SrsMcPsqa.Spike.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="SRS MapCHECK PSQA - Phase 0 spike"
                 Width="1300" Height="720" MinWidth="1000" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SRS MapCHECK PSQA - Phase 0 spike" />

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Inputs and steps -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,12">
                    <ui:InfoBar Title="Test system only" IsOpen="True" IsClosable="False" Severity="Warning"
                                Message="This spike writes to the patient (image copy, plans, dose). Use a test patient." />

                    <TextBlock Style="{StaticResource Section}" Text="Patient and plans" />
                    <TextBlock Style="{StaticResource Label}" Text="Patient ID" />
                    <ui:TextBox x:Name="PatientIdBox" PlaceholderText="from launcher or type" />
                    <TextBlock Style="{StaticResource Label}" Text="Clinical course ID / plan ID" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ClinicalCourseBox" Grid.Column="0" PlaceholderText="course" />
                        <ui:TextBox x:Name="ClinicalPlanBox" Grid.Column="2" PlaceholderText="plan" />
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Text="QA course ID (create it in Eclipse first)" />
                    <ui:TextBox x:Name="QaCourseBox" PlaceholderText="e.g. QA" />

                    <TextBlock Style="{StaticResource Section}" Text="Template phantom" />
                    <TextBlock Style="{StaticResource Label}" Text="Template patient ID / study ID" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TemplatePatientBox" Grid.Column="0" PlaceholderText="patient" />
                        <ui:TextBox x:Name="TemplateStudyBox" Grid.Column="2" PlaceholderText="study" />
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Text="Template image ID (0° or 270°)" />
                    <ui:TextBox x:Name="TemplateImageBox" PlaceholderText="image" />
                    <CheckBox x:Name="ForceCopyBox" Margin="0,6,0,0" Content="Force copy even if the image already exists" />
                    <TextBlock Style="{StaticResource Label}" Text="Phantom structure set ID (filled by step 2)" />
                    <ui:TextBox x:Name="PhantomSsBox" PlaceholderText="structure set" />

                    <TextBlock Style="{StaticResource Section}" Text="QA plan" />
                    <TextBlock Style="{StaticResource Label}" Text="Beam ID to copy (blank = first treatment beam)" />
                    <ui:TextBox x:Name="BeamIdBox" PlaceholderText="beam" />
                    <CheckBox x:Name="CopyAllBox" Margin="0,6,0,0" Content="Copy all treatment beams" />
                    <CheckBox x:Name="SetRxBox" Margin="0,4,0,0" Content="Also set plan prescription from clinical plan" />
                    <TextBlock Style="{StaticResource Label}" Text="Step 3 isocentre: offset from phantom user origin, DICOM x, y, z (mm)" />
                    <ui:TextBox x:Name="Iso1Box" />
                    <TextBlock Style="{StaticResource Label}" Text="Step 3b isocentre: offset from phantom user origin, DICOM x, y, z (mm)" />
                    <ui:TextBox x:Name="Iso2Box" />
                    <CheckBox x:Name="AutoSaveBox" Margin="0,8,0,0" IsChecked="True" Content="SaveModifications after each write" />

                    <TextBlock Style="{StaticResource Section}" Text="Steps" />
                    <WrapPanel x:Name="StepButtons" Margin="0,6,0,0">
                        <ui:Button Margin="0,4,6,0" Content="0. API probe" Icon="{ui:SymbolIcon Code24}" Click="Probe_Click" />
                        <ui:Button Margin="0,4,6,0" Content="1. Open + modify" Icon="{ui:SymbolIcon Person24}" Click="Open_Click" Appearance="Primary" />
                        <ui:Button Margin="0,4,6,0" Content="2. Copy phantom" Icon="{ui:SymbolIcon Image24}" Click="Copy_Click" />
                        <ui:Button Margin="0,4,6,0" Content="2a. Inspect template" Icon="{ui:SymbolIcon Search24}" Click="Inspect_Click" />
                        <ui:Button Margin="0,4,6,0" Content="3. Create QA plan + calc" Icon="{ui:SymbolIcon Add24}" Click="Create_Click" />
                        <ui:Button Margin="0,4,6,0" Content="3b. Move iso + recalc" Icon="{ui:SymbolIcon ArrowMove24}" Click="Move_Click" />
                        <ui:Button Margin="0,4,6,0" Content="Save" Icon="{ui:SymbolIcon Save24}" Click="Save_Click" />
                        <ui:Button Margin="0,4,6,0" Content="Delete spike plans" Icon="{ui:SymbolIcon Delete24}" Click="Delete_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Report" />
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Theme" Icon="{ui:SymbolIcon DarkTheme24}" Click="Theme_Click" />
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Copy report" Icon="{ui:SymbolIcon Copy24}" Click="CopyReport_Click" />
                </DockPanel>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="12,6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing x:Name="Busy" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Ready" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
