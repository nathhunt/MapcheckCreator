<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SRS MapCHECK PSQA Plan Creator: WPF app (.NET Framework 4.8, x64).
    Started with the fake switch it runs on synthetic data; otherwise it connects to Eclipse (ESAPI v18).
    Write-enabled standalone: must be approved in Eclipse Script Approvals before it can create plans.
    EnableWindowsTargeting lets the project compile on non-Windows build machines (CI); it has no effect on Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SrsMcPsqa.App</RootNamespace>
    <AssemblyName>SrsMcPsqa</AssemblyName>
    <Product>SRS MapCHECK PSQA Plan Creator</Product>
    <!-- The informational version is set below to <Version>+<short commit>[-dirty]; stop the SDK appending its own revision. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!--
      Eclipse allows a data-modifying ESAPI call (AddCourse, AddExternalPlanSetup..., CalculateDose...) only when it finds
      the approved script assembly as the caller. So:
      - All ESAPI code (Esapi/) is compiled into this exe, not a separate DLL: a call from a referenced DLL, or from a thread
        with no frame of the exe on it, is refused with "The system did not find a calling assembly ... NoInlining".
      - The exe is never optimised, in Release too: inlining and tail calls can remove the calling frame. ESAPI calls are
        slow anyway and the heavy computation is in SrsMcPsqa.Core, which is still optimised.
    -->
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!--
    Stamp the git commit into the build: InformationalVersion = 1.0.2-beta+a1b2c3d, with "-dirty" when tracked files have
    uncommitted changes, or "+unknown" when git or the repository isn't available. Shown in the window title and the log.
  -->
  <Target Name="StampGitCommit" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true"
          Condition="'$(GitCommitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitStatus" />
    </Exec>
    <PropertyGroup>
      <GitCommit Condition="'$(GitCommitExit)' != '0' Or '$(GitCommit)' == ''">unknown</GitCommit>
      <GitDirty Condition="'$(GitCommitExit)' == '0' And '$(GitStatus)' != ''">-dirty</GitDirty>
      <InformationalVersion>$(Version)+$(GitCommit.Trim())$(GitDirty)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="high" Text="SrsMcPsqa version $(InformationalVersion)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <!-- ESAPI: from the Eclipse installation (GAC on Citrix), never copied next to the exe. -->
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>$(EsapiPath)\VMS.TPS.Common.Model.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>$(EsapiPath)\VMS.TPS.Common.Model.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SrsMcPsqa.Core\SrsMcPsqa.Core.csproj" />
    <ProjectReference Include="..\SrsMcPsqa.Fake\SrsMcPsqa.Fake.csproj" />
  </ItemGroup>

  <Target Name="CheckEsapiPath" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(EsapiPath)\VMS.TPS.Common.Model.API.dll') Or !Exists('$(EsapiPath)\VMS.TPS.Common.Model.Types.dll')"
           Text="ESAPI DLLs not found in EsapiPath='$(EsapiPath)'. Create EsapiPath.user.props in the repository root (see README). On a machine without Eclipse, build tools/EsapiStubs and pass -p:EsapiPath=&lt;repo&gt;/tools/EsapiStubs/out (compile check only)." />
  </Target>

  <ItemGroup>
    <None Include="SrsMcPsqa.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
