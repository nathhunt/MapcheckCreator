<Application x:Class="SrsMcPsqa.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:inf="clr-namespace:SrsMcPsqa.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <inf:BoolToVisibilityConverter x:Key="BoolToVis" />
            <inf:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <inf:InverseBoolConverter x:Key="Not" />
            <inf:NotNullConverter x:Key="NotNull" />
            <inf:StatusBrushConverter x:Key="StatusBrush" />
            <inf:CoverageTextConverter x:Key="CoverageText" />
            <inf:StepGlyphConverter x:Key="StepGlyph" />
            <inf:PrimaryIfTrueConverter x:Key="PrimaryIfTrue" />
            <inf:PrimaryIfTrueConverter x:Key="SecondaryIfTrue" Invert="True" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,8,0,3" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="NudgeButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="Margin" Value="0,0,3,3" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
