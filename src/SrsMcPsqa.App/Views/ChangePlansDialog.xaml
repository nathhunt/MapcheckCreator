<ui:FluentWindow x:Class="SrsMcPsqa.App.Views.ChangePlansDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SrsMcPsqa.App.ViewModels"
                 mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PlanningViewModel}"
                 Title="Change plans" Width="620" SizeToContent="Height" MaxHeight="680"
                 ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Change plans" ShowMinimize="False" ShowMaximize="False" />

        <DockPanel Grid.Row="1" Margin="20,4,20,12">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Body}"
                           Text="Choose how many QA plans you want, the orientation of each, and which PTVs a plan must include. The app then finds the best array positions within these choices. PTVs you don't tick are placed wherever they fit best." />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                    <TextBlock VerticalAlignment="Center" Text="Number of QA plans" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:TextBox Width="70" Text="{Binding NumberOfPlans, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <ItemsControl ItemsSource="{Binding ConstraintRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="70" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Orientation" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox Width="110" ItemsSource="{x:Static vm:ConstraintRowViewModel.OrientationChoices}"
                                                  SelectedItem="{Binding Orientation}" DisplayMemberPath="Text" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,2" FontSize="12" Text="Must include:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,16,0" Content="{Binding Id}" IsChecked="{Binding IsAssigned}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Content="Clear all ticks" Command="{Binding ClearAssignmentsCommand}" />
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="90" Content="Cancel" IsCancel="True" />
                <ui:Button DockPanel.Dock="Right" Content="Find best positions" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
