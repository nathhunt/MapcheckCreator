<UserControl x:Class="SrsMcPsqa.App.Views.ProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SrsMcPsqa.App.ViewModels"
             xmlns:inf="clr-namespace:SrsMcPsqa.App.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ProgressViewModel}">
    <!-- DataContext: ProgressViewModel. Modal panel for long operations; shown over the content while IsOpen. -->
    <UserControl.Resources>
        <!-- Overall bar: indeterminate while running without an estimate -->
        <Style x:Key="OverallBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding OverallHasEstimate}" Value="False" />
                        <Condition Binding="{Binding IsRunning}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsIndeterminate" Value="True" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown only for a running calculation step -->
        <Style x:Key="RunningCalculation" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCalculation}" Value="True" />
                        <Condition Binding="{Binding IsRunning}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimingText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static inf:StatusBrushConverter.Caution}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MuRowTemplate" DataType="{x:Type vm:MuRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Body}" Text="{Binding BeamId}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding QaMu}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Style="{StaticResource Body}" Text="{Binding ClinicalMu}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Style="{StaticResource Body}" Text="{Binding Difference}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Margin="12,0,0,0" FontWeight="Bold"
                           Text="{Binding Matches, Converter={StaticResource StepGlyph}}"
                           Foreground="{Binding Matches, Converter={StaticResource StatusBrush}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GenericStepTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Width="20" Text="{Binding State, Converter={StaticResource StepGlyph}}" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- One step of a QA plan: name, Eclipse's warnings, and calculation progress while it runs -->
        <DataTemplate x:Key="PlanStepTemplate" DataType="{x:Type vm:PlanStepViewModel}">
            <StackPanel Margin="0,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding DurationText}" />
                    <TextBlock Width="20" FontWeight="Bold" Text="{Binding State, Converter={StaticResource StepGlyph}}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </DockPanel>
                <TextBlock Margin="20,1,0,2" FontSize="11" TextWrapping="Wrap" Text="{Binding WarningsText}"
                           Foreground="{x:Static inf:StatusBrushConverter.Caution}"
                           Visibility="{Binding WarningsText, Converter={StaticResource BoolToVis}}" />
                <StackPanel Margin="20,3,0,3" Style="{StaticResource RunningCalculation}">
                    <ProgressBar Height="6" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                 IsIndeterminate="{Binding HasEstimate, Converter={StaticResource Not}}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding TimingText}" Style="{StaticResource TimingText}" />
                    <TextBlock Margin="0,1,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding EclipseText}"
                               Visibility="{Binding EclipseText, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- One card per QA plan -->
        <DataTemplate x:Key="PlanCardTemplate" DataType="{x:Type vm:PlanProgressViewModel}">
            <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsExpanded}" Padding="6,0" MinHeight="0"
                                      Content="Steps" FontSize="11" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Text="{Binding Summary}" />
                        <TextBlock Width="20" FontWeight="Bold" VerticalAlignment="Center"
                                   Text="{Binding State, Converter={StaticResource StepGlyph}}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Header}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource PlanStepTemplate}" Margin="20,4,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Border Width="720" Margin="0,16"
                VerticalAlignment="Center" CornerRadius="8" Padding="20"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <!-- Title and elapsed time -->
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                               Visibility="{Binding HasPlans, Converter={StaticResource BoolToVis}}">
                        <Run Text="Elapsed" /> <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Section}" Text="{Binding Title}" />
                </DockPanel>

                <!-- Generic operations: indeterminate bar and the latest message -->
                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasPlans, Converter={StaticResource InverseBoolToVis}}">
                    <ProgressBar Height="4" Margin="0,4,0,8" IsIndeterminate="{Binding IsRunning}" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding CurrentText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                </StackPanel>

                <!-- QA plan operations: overall progress -->
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,10" Visibility="{Binding HasPlans, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding OverallRemainingText}" />
                        <TextBlock Style="{StaticResource Label}" Text="{Binding OverallText}" />
                    </DockPanel>
                    <ProgressBar Height="6" Margin="0,4,0,0" Maximum="1" Value="{Binding OverallFraction, Mode=OneWay}"
                                 Style="{StaticResource OverallBar}" />
                </StackPanel>

                <!-- Buttons -->
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
                    <ui:Button DockPanel.Dock="Right" Content="Close" MinWidth="90" Command="{Binding CloseCommand}"
                               Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" Appearance="Primary" />
                    <ui:Button DockPanel.Dock="Right" Content="Cancel after current plan" Command="{Binding CancelCommand}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                               IsEnabled="{Binding CancelRequested, Converter={StaticResource Not}}" />
                </DockPanel>

                <!-- Log -->
                <Expander DockPanel.Dock="Bottom" Header="Details (log)" Margin="0,8,0,0"
                          IsExpanded="{Binding HasPlans, Mode=OneWay, Converter={StaticResource Not}}">
                    <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11" Height="140" />
                </Expander>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasPlans, Converter={StaticResource BoolToVis}}"
                           Text="Calculation progress comes from Eclipse's messages when it provides them (&quot;Eclipse: 43%&quot;); otherwise it is estimated from earlier calculations on this computer. A calculation can't be interrupted: Cancel stops once the current plan is finished and saved." />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Visibility="{Binding HasPlans, Converter={StaticResource InverseBoolToVis}}"
                           Text="Eclipse calculations can't be interrupted: Cancel stops after the current step." />

                <!-- MU check of the latest calculation -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding HasMu, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="{Binding MuTitle}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="Beam" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="QA MU" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="Clinical MU" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="Difference" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MuRows}" ItemTemplate="{StaticResource MuRowTemplate}" />
                </StackPanel>

                <!-- Generic step list -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource GenericStepTemplate}" Margin="0,0,0,8"
                              Visibility="{Binding HasPlans, Converter={StaticResource InverseBoolToVis}}" />

                <!-- One card per QA plan -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPlans, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Plans}" ItemTemplate="{StaticResource PlanCardTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
