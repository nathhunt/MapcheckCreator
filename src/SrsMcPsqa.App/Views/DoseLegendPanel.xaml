<UserControl x:Class="SrsMcPsqa.App.Views.DoseLegendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SrsMcPsqa.App.Controls">
    <!-- Expects a DataContext with Scene and Session.DoseWash (planning and review pages). -->
    <DockPanel Background="#14161A">
        <StackPanel DockPanel.Dock="Bottom" Margin="4,2,4,4">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Width="40" VerticalAlignment="Center" FontSize="11" Foreground="#E6E6E6" Text="Upper" />
                <TextBox FontSize="11" Padding="2,0" MinHeight="0" Text="{Binding Session.DoseWash.UpperText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Upper level in % (or 'max' for the maximum dose on the plane). Press Enter or Tab to apply." />
            </DockPanel>
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Width="40" VerticalAlignment="Center" FontSize="11" Foreground="#E6E6E6" Text="Lower" />
                <TextBox FontSize="11" Padding="2,0" MinHeight="0" Text="{Binding Session.DoseWash.LowerText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Lower level in %: dose below it is not coloured. Press Enter or Tab to apply." />
            </DockPanel>
            <Button Margin="0,4,0,0" FontSize="11" Padding="2" Content="Reset" Command="{Binding Session.DoseWash.ResetCommand}"
                    ToolTip="Lower 20 %, upper = maximum dose" />
        </StackPanel>
        <controls:DoseLegend Scene="{Binding Scene}" LowerPercent="{Binding Session.DoseWash.LowerPercent}"
                             UpperPercent="{Binding Session.DoseWash.UpperPercent}" />
    </DockPanel>
</UserControl>
