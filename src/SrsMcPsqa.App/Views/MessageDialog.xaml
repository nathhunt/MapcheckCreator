<ui:FluentWindow x:Class="SrsMcPsqa.App.Views.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="560" SizeToContent="Height" MaxHeight="640"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />

        <DockPanel Grid.Row="1" Margin="20,4,20,12">
            <ui:SymbolIcon x:Name="KindIcon" DockPanel.Dock="Left" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Top" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </DockPanel>

        <Expander x:Name="DetailsExpander" Grid.Row="2" Margin="20,0,20,12" Header="Details" Visibility="Collapsed">
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                     MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Expander>

        <Border Grid.Row="3" Padding="20,12" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <ui:Button x:Name="CopyButton" DockPanel.Dock="Left" Content="Copy details" Icon="{ui:SymbolIcon Copy24}"
                           Visibility="Collapsed" Click="Copy_Click" />
                <ui:Button x:Name="CancelButton" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="90" IsCancel="True" Click="Cancel_Click" />
                <ui:Button x:Name="OkButton" DockPanel.Dock="Right" MinWidth="90" Appearance="Primary" IsDefault="True" Click="Ok_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
