<UserControl x:Class="SrsMcPsqa.App.Views.PlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SrsMcPsqa.App.ViewModels"
             xmlns:controls="clr-namespace:SrsMcPsqa.App.Controls"
             xmlns:views="clr-namespace:SrsMcPsqa.App.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PlanningViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== header ============================== -->
        <StackPanel Grid.Row="0" Margin="20,12,20,8">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,4" Text="3 · Array planning" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13"
                       Text="Check the suggested QA plans. Select a plan to see where the array cuts the PTVs and move it if needed. Then create the plans." />
        </StackPanel>

        <!-- ============================== body ============================== -->
        <Grid Grid.Row="1" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- left: the plans -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <ui:ProgressRing DockPanel.Dock="Right" Width="16" Height="16" IsIndeterminate="True"
                                         Visibility="{Binding IsComputing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Section}" Text="QA plans" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding ResultSummary}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Border Padding="10,8" CornerRadius="6" Margin="0,0,0,8" Background="#22D08A00"
                            Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Text="{Binding StringFormat='⚠ {0}'}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ui:Button HorizontalAlignment="Stretch" Content="Change plans…" Icon="{ui:SymbolIcon Edit24}"
                               ToolTip="Choose the number of plans, their orientations and which PTVs each must include"
                               Command="{Binding ChangePlansCommand}" IsEnabled="{Binding HasPlanes}" />
                    <Expander Margin="0,8,0,0" Header="Options">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,3" Text="Array orientation" />
                            <ComboBox ItemsSource="{x:Static vm:PlanningViewModel.Preferences}" SelectedItem="{Binding Preference}" DisplayMemberPath="Text" />
                            <TextBlock Style="{StaticResource Label}" Text="Position the array for" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Alpha}" TickFrequency="0.05" IsSnapToTickEnabled="True" IsDirectionReversed="True" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" Text="high dose" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="more PTV area" />
                                <TextBlock />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Edge margin, coverage threshold and minimum diodes are in Settings." />
                            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="Recommend again" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Appearance="{Binding OptionsChanged, Converter={StaticResource PrimaryIfTrue}}"
                                       Command="{Binding RecommendCommand}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <ListBox ItemsSource="{Binding Planes}" SelectedItem="{Binding SelectedPlane}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Title}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" FontStyle="Italic" Text="moved"
                                               Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding PtvText}" />
                                <TextBlock FontSize="12" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Opacity="0.8" Text="{Binding IsoFromOriginText, StringFormat='Iso from MapCHECK origin: {0}'}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding Clearance.Summary}" Foreground="{Binding Clearance.Brush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- middle: view + table -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <RadioButton DockPanel.Dock="Left" Content="Array plane" GroupName="View" MinWidth="0" Margin="0,0,16,0"
                                 IsChecked="{Binding Show3D, Converter={StaticResource Not}}" />
                    <RadioButton DockPanel.Dock="Left" Content="3D" GroupName="View" MinWidth="0" IsChecked="{Binding Show3D}" />
                    <CheckBox DockPanel.Dock="Right" Content="Show diodes" IsChecked="{Binding ShowDiodes}" />
                </DockPanel>

                <Grid Grid.Row="1" Visibility="{Binding Show3D, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <controls:PlaneView MinHeight="260" Scene="{Binding Scene}" Overlay="{Binding Overlay}" AllowDrag="True"
                                        DragCommand="{Binding DragCommand}"
                                        LowerPercent="{Binding Session.DoseWash.LowerPercent}" UpperPercent="{Binding Session.DoseWash.UpperPercent}" />
                    <views:DoseLegendPanel Grid.Column="1" Margin="4,0,0,0" />
                </Grid>
                <controls:Scene3DView Grid.Row="1" Scene="{Binding Scene3D}"
                                      Visibility="{Binding Show3D, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right" Content="Show details" IsChecked="{Binding ShowDetails}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Text="PTVs on the selected plan (before QA calculation)" />
                    </DockPanel>
                    <DataGrid MaxHeight="150" ItemsSource="{Binding SelectedPlane.Metrics}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12"
                              Visibility="{Binding ShowDetails, Converter={StaticResource InverseBoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="22">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Rectangle Width="10" Height="10" Fill="{Binding Brush}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PTV" Binding="{Binding Id}" Width="2*" />
                            <DataGridTemplateColumn Header="QA plan" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlanText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlanText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnThisPlan}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rx (Gy)" Binding="{Binding Rx}" Width="*" />
                            <DataGridTextColumn Header="Area on array (mm²)" Binding="{Binding Area}" Width="1.4*" />
                            <DataGridTextColumn Header="Diodes in PTV" Binding="{Binding Diodes}" Width="*" />
                            <DataGridTextColumn Header="Diodes ≥ Rx" Binding="{Binding DiodesAtRx}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid MaxHeight="150" ItemsSource="{Binding SelectedPlane.Metrics}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="12"
                              Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PTV" Binding="{Binding Id}" Width="2*" />
                            <DataGridTextColumn Header="Area on array" Binding="{Binding Area}" Width="*" />
                            <DataGridTextColumn Header="Max area" Binding="{Binding MaxArea}" Width="*" />
                            <DataGridTextColumn Header="≥ Rx area / max" Binding="{Binding HighDose}" Width="*" />
                            <DataGridTextColumn Header="Mean D/Rx" Binding="{Binding MeanRatio}" Width="*" />
                            <DataGridTextColumn Header="Score J" Binding="{Binding Score}" Width="*" />
                            <DataGridTextColumn Header="J / best" Binding="{Binding Relative}" Width="*" />
                            <DataGridTextColumn Header="Diodes" Binding="{Binding Diodes}" Width="*" />
                            <DataGridTextColumn Header="≥ Rx" Binding="{Binding DiodesAtRx}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <!-- right: adjust the selected plan -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding SelectedPlane, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Section}" Text="Adjust array" />
                    <TextBlock Style="{StaticResource Hint}" Text="Moves the array relative to the patient. You can also drag it in the view." />
                    <views:IsoShiftCard Margin="0,10,0,0" Title="{Binding SelectedPlane.Title, StringFormat='QA isocentre · {0}'}"
                                        Offset="{Binding SelectedPlane.IsoFromOrigin}" />
                    <views:ClearancePanel Margin="0,8,0,0" DataContext="{Binding SelectedPlane.Clearance}" />

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Step" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ComboBox ItemsSource="{x:Static vm:PlanningViewModel.NudgeSteps}" SelectedItem="{Binding NudgeStep}" ItemStringFormat="{}{0} mm" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Label}" Text="In the array plane" />
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="66" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <ui:Button Grid.Row="0" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" Content="▲ S" ToolTip="Superior"
                                   Command="{Binding NudgeCommand}" CommandParameter="v:1" />
                        <ui:Button Grid.Row="1" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" Content="{Binding SelectedPlane.UMinusText}" ContentStringFormat="◀ {0}"
                                   Command="{Binding NudgeCommand}" CommandParameter="u:-1" />
                        <ui:Button Grid.Row="1" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon CenterHorizontal24}"
                                   ToolTip="Centre on PTVs: centre the area where the array cuts the PTVs"
                                   Command="{Binding CentreOnPtvsCommand}" />
                        <ui:Button Grid.Row="1" Grid.Column="2" Margin="2" HorizontalAlignment="Stretch" Content="{Binding SelectedPlane.UPlusText}" ContentStringFormat="{}{0} ▶"
                                   Command="{Binding NudgeCommand}" CommandParameter="u:1" />
                        <ui:Button Grid.Row="2" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" Content="▼ I" ToolTip="Inferior"
                                   Command="{Binding NudgeCommand}" CommandParameter="v:-1" />
                    </Grid>

                    <TextBlock Style="{StaticResource Label}" Text="{Binding SelectedPlane.DepthAxisText}" />
                    <UniformGrid Columns="2">
                        <ui:Button Margin="0,0,2,0" HorizontalAlignment="Stretch" Content="{Binding SelectedPlane.NMinusText}"
                                   Command="{Binding NudgeCommand}" CommandParameter="n:-1" />
                        <ui:Button Margin="2,0,0,0" HorizontalAlignment="Stretch" Content="{Binding SelectedPlane.NPlusText}"
                                   Command="{Binding NudgeCommand}" CommandParameter="n:1" />
                    </UniformGrid>

                    <ui:Button Margin="0,14,0,0" HorizontalAlignment="Stretch" Content="Reset to suggested" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Command="{Binding ResetPlaneCommand}" />

                    <Expander Margin="0,10,0,0" Header="Exact position">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="QA isocentre relative to the MapCHECK user origin (array centre), in mm." />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="+L / −R" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding SelectedPlane.IsoX, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,6,0" Text="+P / −A" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding SelectedPlane.IsoY, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,6,0" Text="+S / −I" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding SelectedPlane.IsoZ, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <ui:Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Content="Apply" Command="{Binding ApplyCentreCommand}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================== footer ============================== -->
        <Border Grid.Row="2" Padding="20,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" MinWidth="180" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           Content="{Binding CreateButtonText}" Command="{Binding CreateQaPlansCommand}" IsEnabled="{Binding CanCreate}" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource Hint}" FontSize="12" Text="{Binding CreateHint}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
