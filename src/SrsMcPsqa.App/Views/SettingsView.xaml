<UserControl x:Class="SrsMcPsqa.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SrsMcPsqa.App.ViewModels"
             xmlns:inf="clr-namespace:SrsMcPsqa.App.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{x:Static inf:StatusBrushConverter.Bad}" Background="#22D13438"
                    Visibility="{Binding Session.HasSettingsError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="The department settings file could not be read. Built-in defaults are shown and in use; creating QA plans is off." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Session.SettingsError, StringFormat='Reason: {0}. Fix the file, then Reload. Saving here replaces it (the unreadable file is kept as .bak).'}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{x:Static inf:StatusBrushConverter.Caution}" Background="#22D08A00">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Department settings: everything on this page except 'Appearance and logging' applies to everyone using this installation." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding DepartmentPath, StringFormat='Stored in {0}. Saving changes to them asks for confirmation and needs write access to the app folder; the previous version is kept as .bak. Theme and log level are personal.'}" />
                </StackPanel>
            </Border>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Template phantom patient" />
                    <TextBlock Style="{StaticResource Hint}" Text="Images are copied from this patient into each QA patient (once). In each image the user origin must be the centre of the detector array. Department setting: test and production installations have separate settings files, so their values never mix." />
                    <TextBlock Style="{StaticResource Label}" Text="Template patient ID" />
                    <ui:TextBox Text="{Binding Edit.TemplatePatientId}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="0° image ID (array horizontal)" />
                            <ui:TextBox Text="{Binding Edit.Template0ImageId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="0° study ID (optional; empty = search all studies)" />
                            <ui:TextBox Text="{Binding Edit.Template0StudyId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="270° image ID (array vertical)" />
                            <ui:TextBox Text="{Binding Edit.Template270ImageId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="270° study ID (optional; empty = search all studies)" />
                            <ui:TextBox Text="{Binding Edit.Template270StudyId}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Margin="0,10,0,0" Content="Recreate template structures in the copied image (if the copy doesn't bring them)"
                              IsChecked="{Binding Edit.CopyTemplateStructures}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding InstallationFolder, StringFormat='Installation: {0}'}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Validate opens the template patient read-only and checks these IDs (before or after saving)." />
                    <ui:Button Margin="0,10,0,0" Content="Validate" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ValidateCommand}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ValidationResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Gantry–couch collision check" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Warns when the treatment head comes close to the couch top, and suggests a lateral phantom offset. It never blocks creating plans." />

                    <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,8" Text="Phantom on the couch" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Array centre height above the couch top" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionOriginAboveCouchMm}" TextAlignment="Right" />
                            </DockPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Required. 0 switches the check off." />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Couch head end, superior of the array centre" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionCouchHeadEndSupMm}" TextAlignment="Right" />
                            </DockPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Negative when the array centre overhangs the end of the couch." />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Lateral offset on the couch" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionPhantomLateralOffsetMm}" TextAlignment="Right" />
                            </DockPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="+ towards the phantom's left; 0 = centred." />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Largest lateral offset to suggest" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionMaxLateralOffsetMm}" TextAlignment="Right" />
                            </DockPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Suggestions stay within ± this value." />
                        </Grid>

                    <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,6,0,8" Text="Tolerances (clearance before the laser guard trips)" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Warning below" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionWarningMm}" TextAlignment="Right" />
                            </DockPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Collision risk below" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionRiskMm}" TextAlignment="Right" />
                            </DockPanel>
                        </Grid>

                    <Expander Margin="0,6,0,0" Header="Head and couch dimensions">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="The head is a cylinder around the beam axis; the couch top has the Exact IGRT cross-section (sides curving in towards the bottom), scaled to the width and thickness below." />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Head face from the isocentre" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionHeadClearanceMm}" TextAlignment="Right" />
                            </DockPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="37.5 cm: the TrueBeam laser guard trip radius." />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Head radius" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionHeadRadiusMm}" TextAlignment="Right" />
                            </DockPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Half the head's width (76.5 cm across)." />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Couch top width at its widest" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionCouchWidthMm}" TextAlignment="Right" />
                            </DockPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" Text="Couch top thickness" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding Edit.CollisionCouchThicknessMm}" TextAlignment="Right" />
                            </DockPanel>
                        </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="QA plans" />
                    <TextBlock Style="{StaticResource Label}" Text="QA course ID (used if the patient has it, otherwise created with the first QA plan)" />
                    <ui:TextBox Text="{Binding Edit.QaCourseId}" />
                    <TextBlock Style="{StaticResource Label}" Text="Plan ID pattern ({n} = number, {orient} = 0 or 270; max 13 characters)" />
                    <ui:TextBox Text="{Binding Edit.PlanNamingPattern}" Width="240" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Label}" Text="Helper PTV patterns (comma-separated, * = any text; listed but unticked by default)" />
                    <ui:TextBox Text="{Binding Edit.HelperPatterns}" Width="240" HorizontalAlignment="Left" />
                    <CheckBox Margin="0,10,0,0" Content="Save to Eclipse after every completed write (recommended)" IsChecked="{Binding Edit.AutoSave}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Optimisation defaults" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="Round shifts smaller than" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" Text="mm" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Text="{Binding Edit.ShiftThresholdMm}" TextAlignment="Right" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Per axis, to zero: the QA isocentre shift from the MapCHECK origin in array planning, and the change in position when fine-tuning. 0 = off." />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Edge margin (mm)" />
                            <ui:TextBox Text="{Binding Edit.EdgeMarginMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="τ coverage threshold" />
                            <ui:TextBox Text="{Binding Edit.Tau}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Style="{StaticResource Label}" Text="Minimum diodes in PTV" />
                            <ui:TextBox Text="{Binding Edit.MinDiodes}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="α default (1 = high dose, 0 = coverage)" />
                            <ui:TextBox Text="{Binding Edit.Alpha}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Fine-tune range in-plane (± mm)" />
                            <ui:TextBox Text="{Binding Edit.FineTuneInPlaneRangeMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Style="{StaticResource Label}" Text="Fine-tune range normal (± mm)" />
                            <ui:TextBox Text="{Binding Edit.FineTuneNormalRangeMm}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Appearance and logging (personal)" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Theme" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Edit.Theme}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Log level" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.LogLevels}" SelectedItem="{Binding Edit.LogLevel}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding LogFolder, StringFormat='Your log file: {0}'}" />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Save" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Reload (discard unsaved changes)" Command="{Binding ReloadCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding Status}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding UserPath, StringFormat='Your settings: {0}'}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding DepartmentPath, StringFormat='Department defaults (read-only): {0}'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
