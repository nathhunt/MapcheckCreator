<UserControl x:Class="SrsMcPsqa.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SrsMcPsqa.App.ViewModels"
             xmlns:inf="clr-namespace:SrsMcPsqa.App.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{x:Static inf:StatusBrushConverter.Caution}" Background="#22D08A00">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Department settings: everything on this page except 'Appearance and logging' applies to everyone using this installation." />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding DepartmentPath, StringFormat='Stored in {0}. Saving changes to them asks for confirmation and needs write access to the app folder; the previous version is kept as .bak. Theme and log level are personal.'}" />
                </StackPanel>
            </Border>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Template phantom patient" />
                    <TextBlock Style="{StaticResource Hint}" Text="Images are copied from this patient into each QA patient (once). In each image the user origin must be the centre of the detector array. Department setting: test and production installations have separate settings files, so their values never mix." />
                    <TextBlock Style="{StaticResource Label}" Text="Template patient ID" />
                    <ui:TextBox Text="{Binding Edit.TemplatePatientId}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="0° image ID (array horizontal)" />
                            <ui:TextBox Text="{Binding Edit.Template0ImageId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="0° study ID (optional; empty = search all studies)" />
                            <ui:TextBox Text="{Binding Edit.Template0StudyId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="270° image ID (array vertical)" />
                            <ui:TextBox Text="{Binding Edit.Template270ImageId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="270° study ID (optional; empty = search all studies)" />
                            <ui:TextBox Text="{Binding Edit.Template270StudyId}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Margin="0,10,0,0" Content="Recreate template structures in the copied image (if the copy doesn't bring them)"
                              IsChecked="{Binding Edit.CopyTemplateStructures}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding InstallationFolder, StringFormat='Installation: {0}'}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Validate opens the template patient read-only and checks these IDs (before or after saving)." />
                    <ui:Button Margin="0,10,0,0" Content="Validate" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ValidateCommand}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ValidationResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding Severity, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Gantry–couch collision check" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Warns (never blocks) when the treatment head comes close to the couch top for a QA isocentre, and suggests a lateral phantom offset on the couch. Simple geometric model: the head is a cylinder, the couch top a box; the phantom isn't modelled. Head defaults (41.5 cm from the isocentre, 76.5 cm across) are the values used by open-source ESAPI collision scripts for Varian C-arm linacs; couch width is the 53 cm Exact IGRT top, thickness an estimate. Check them for your machine. All values in mm." />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="MapCHECK user origin height above the couch top (required)" />
                            <ui:TextBox Text="{Binding Edit.CollisionOriginAboveCouchMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Couch top head end, superior of the user origin (− if the phantom overhangs)" />
                            <ui:TextBox Text="{Binding Edit.CollisionCouchHeadEndSupMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Phantom lateral offset on the couch (+ towards phantom left; 0 = centred)" />
                            <ui:TextBox Text="{Binding Edit.CollisionPhantomLateralOffsetMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Largest lateral offset to suggest (±)" />
                            <ui:TextBox Text="{Binding Edit.CollisionMaxLateralOffsetMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Warning below (clearance)" />
                            <ui:TextBox Text="{Binding Edit.CollisionWarningMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Collision risk below (clearance)" />
                            <ui:TextBox Text="{Binding Edit.CollisionRiskMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Head: isocentre to head face (collimator cover)" />
                            <ui:TextBox Text="{Binding Edit.CollisionHeadClearanceMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Head: radius around the beam axis" />
                            <ui:TextBox Text="{Binding Edit.CollisionHeadRadiusMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Couch top width" />
                            <ui:TextBox Text="{Binding Edit.CollisionCouchWidthMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Couch top thickness" />
                            <ui:TextBox Text="{Binding Edit.CollisionCouchThicknessMm}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="QA plans" />
                    <TextBlock Style="{StaticResource Label}" Text="QA course ID (used if the patient has it, otherwise created with the first QA plan)" />
                    <ui:TextBox Text="{Binding Edit.QaCourseId}" />
                    <TextBlock Style="{StaticResource Label}" Text="Plan ID pattern ({n} = number, {orient} = 0 or 270; max 13 characters)" />
                    <ui:TextBox Text="{Binding Edit.PlanNamingPattern}" Width="240" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Label}" Text="Helper PTV patterns (comma-separated, * = any text; listed but unticked by default)" />
                    <ui:TextBox Text="{Binding Edit.HelperPatterns}" Width="240" HorizontalAlignment="Left" />
                    <CheckBox Margin="0,10,0,0" Content="Save to Eclipse after every completed write (recommended)" IsChecked="{Binding Edit.AutoSave}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Optimisation defaults" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Edge margin (mm)" />
                            <ui:TextBox Text="{Binding Edit.EdgeMarginMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="τ coverage threshold" />
                            <ui:TextBox Text="{Binding Edit.Tau}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Style="{StaticResource Label}" Text="Minimum diodes in PTV" />
                            <ui:TextBox Text="{Binding Edit.MinDiodes}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="α default (1 = high dose, 0 = coverage)" />
                            <ui:TextBox Text="{Binding Edit.Alpha}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Fine-tune range in-plane (± mm)" />
                            <ui:TextBox Text="{Binding Edit.FineTuneInPlaneRangeMm}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Style="{StaticResource Label}" Text="Fine-tune range normal (± mm)" />
                            <ui:TextBox Text="{Binding Edit.FineTuneNormalRangeMm}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Appearance and logging (personal)" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="Theme" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Edit.Theme}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Log level" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.LogLevels}" SelectedItem="{Binding Edit.LogLevel}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding LogFolder, StringFormat='Logs: {0}'}" />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Save" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Reload (discard unsaved changes)" Command="{Binding ReloadCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding Status}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding UserPath, StringFormat='Your settings: {0}'}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding DepartmentPath, StringFormat='Department defaults (read-only): {0}'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
