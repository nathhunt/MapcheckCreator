<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure planning logic. NO ESAPI and NO WPF references. Units: mm, Gy, DICOM patient coordinates. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SrsMcPsqa.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiler polyfills (init, records, nullable attributes) for netstandard2.0. Build-time only. -->
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SrsMcPsqa.Core.Tests" />
  </ItemGroup>

</Project>
