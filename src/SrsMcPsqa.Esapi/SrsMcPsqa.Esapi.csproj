<Project Sdk="Microsoft.NET.Sdk">

  <!-- ESAPI v18 implementation of IPlanningService. All ESAPI calls run on one STA thread (EsapiWorker). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SrsMcPsqa.Esapi</RootNamespace>
    <!--
      Never optimise this assembly, in Release too. Eclipse allows a data-modifying ESAPI call only after finding the calling
      (approved) script assembly on the call stack. JIT optimisation (inlining, tail calls) can remove our frames, and
      Eclipse then refuses with "The system did not find a calling assembly ... MethodImplOptions.NoInlining".
      Unoptimised Debug builds worked on the test system; optimised Release builds failed on AddCourse. ESAPI calls are
      slow anyway, so there is no measurable cost.
    -->
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>$(EsapiPath)\VMS.TPS.Common.Model.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>$(EsapiPath)\VMS.TPS.Common.Model.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SrsMcPsqa.Core\SrsMcPsqa.Core.csproj" />
  </ItemGroup>

  <Target Name="CheckEsapiPath" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(EsapiPath)\VMS.TPS.Common.Model.API.dll') Or !Exists('$(EsapiPath)\VMS.TPS.Common.Model.Types.dll')"
           Text="ESAPI DLLs not found in EsapiPath='$(EsapiPath)'. Create EsapiPath.user.props in the repository root (see README). On a machine without Eclipse, build tools/EsapiStubs and pass -p:EsapiPath=&lt;repo&gt;/tools/EsapiStubs/out (compile check only)." />
  </Target>

</Project>
